@inject IThemeContext themeContext
@model MenuModel
@{

    var themeName = await themeContext.GetWorkingThemeNameAsync();
}
@using Nop.Core.Domain.Menus;
<div class="mtheader__bottom-wrapper p-relative d-flex align-items-center justify-content-end justify-content-xxl-between">
    <div class="mtheader__bottom-menu d-none d-lg-block">
        <nav class="mt-mobile-menu-active">
            <ul>
                <li class="has-dropdown">
                    <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)">@T("Menu.Home")</a>
                    <ul class="sub-menu mt-submenu">
                        <li><a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)">@T("Menu.Home")</a></li>
                    </ul>
                </li>
                <li><a href="@(await NopUrl.RouteTopicUrlAsync("AboutUs"))">@T("Menu.About")</a></li>
                <li class="has-dropdown">
                    <a href="#">@T("Menu.Shop")</a>
                    <ul class="sub-menu mt-submenu">
                        <li><a href="#">@T("Menu.Shop")</a></li>
                        <li><a href="@Url.RouteUrl(NopRouteNames.General.WISHLIST)">@T("Menu.Wishlist")</a></li>
                        <li><a href="@Url.RouteUrl(NopRouteNames.General.CART)">@T("Menu.Cart")</a></li>
                        <li><a href="@Url.RouteUrl(NopRouteNames.Standard.CHECKOUT)">@T("Menu.Checkout")</a></li>
                    </ul>
                </li>
                <li class="has-dropdown">
                    <a href="#">@T("Menu.Pages")</a>
                    <ul class="sub-menu mt-submenu">
                        <li><a href="@(await NopUrl.RouteTopicUrlAsync("AboutUs"))">@T("Menu.About")</a></li>
                        <li><a href="@Url.RouteUrl(NopRouteNames.General.CONTACT_US)">@T("Menu.Contact")</a></li>
                        <li><a href="@Url.RouteUrl(NopRouteNames.General.WISHLIST)">@T("Menu.Wishlist")</a></li>
                        <li><a href="@Url.RouteUrl(NopRouteNames.Standard.CHECKOUT)">@T("Menu.Checkout")</a></li>
                        <li><a href="@Url.RouteUrl(NopRouteNames.General.CART)">@T("Menu.Cart")</a></li>
                        <li><a href="@Url.RouteUrl(NopRouteNames.General.LOGIN)">@T("Menu.Login")</a></li>
                        <li><a href="@Url.RouteUrl(NopRouteNames.Standard.REGISTER)">@T("Menu.Register")</a></li>
                    </ul>
                </li>

                <li class="has-dropdown">
                    <a href="@Url.RouteUrl(NopRouteNames.General.BLOG)">@T("Menu.Blog")</a>
                    <ul class="sub-menu mt-submenu">
                        <li><a href="@Url.RouteUrl(NopRouteNames.General.BLOG)">@T("Menu.Blog")</a></li>
                    </ul>
                </li>

                <li>
                    <a href="@Url.RouteUrl(NopRouteNames.General.CONTACT_US)">@T("Menu.Contact")</a>
                </li>
            </ul>
        </nav>
    </div>
    <div class="mtheader__bottom-right d-none d-xxl-block">
        <a href="tel:9112456859">@T("Menu.Hotline") <span> +(00)91 1245 6859</span></a>
        <a href="#" class="mt-btn mt-btn-sm">
            <i class="fa-solid fa-bolt"></i>@T("Menu.FlashSale")
        </a>

    </div>

    <div class="mtheader__mobile-cart d-lg-none mr-30">
        <div class="mtheader__midel-account-wrap p-relative d-flex align-items-center justify-content-between">
            <div class="mtheader__midel-login">
                <a href="login.html" class="mtheader__midel-login-inner">
                    <i class="fa-solid fa-user-plus" data-color="#fff"></i>
                </a>
            </div>
            <span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="14" viewBox="0 0 16 14"
                     fill="none">
                    <path d="M8.00011 0.21582L9.68397 5.39819H15.133L10.7246 8.60108L12.4085 13.7834L8.00011 10.5806L3.59172 13.7834L5.27558 8.60108L0.867188 5.39819H6.31626L8.00011 0.21582Z"
                          fill="#FDD057" />
                </svg>
            </span>
            <div class="mtheader__midel-login">
                <div class="mtcartmini-open-btn">
                    <div class="mtheader__midel-card-value">
                        <i class="fa-solid fa-basket-shopping" data-color="#fff"></i>
                        <p>2</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-header-toogle d-lg-none text-end">
        <button class="mt-offcanvas-toogle"><i class="fa-regular fa-bars-staggered"></i></button>
    </div>
</div>
